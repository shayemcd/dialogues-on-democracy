vs = document.querySelectorAll('div.QuestionOuter.BorderColor.TE');  \/\/ find all text entry divs\n\tdivs.forEach((div, idx) => {\n\t\tlet childDivTextBox = div.querySelector(\"input\");\n\t\tif (childDivTextBox && appData[idx]) {\n\t\t\tchildDivTextBox.value = JSON.stringify(appData[idx]);\n\t\t}\n\t\tif (hideTextbox) {\t\n\t\t\tif (div) div.style.display = 'none';  \n\t\t}\n\t});\n\t\n\t\/\/ remove separators in case there are any\n\tconst seps = document.querySelectorAll(\"div.Separator\");\n\tseps.forEach((div) => {\n\t\tdiv.style.display = 'none';\n\t});\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\n\t\/\/ remove separators in case there are any\n\tconst separators = document.querySelectorAll(\"div.Separator\");\n\tseparators.forEach((div) => {\n\t\tdiv.style.display = 'none';\n\t});\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});"}},{"SurveyID":"SV_39IRNTCn5hF9YDs","Element":"SQ","PrimaryAttribute":"QID123","SecondaryAttribute":"Now, we'd like to ask you a series of brief questions focusing on your future actions. Specifical...","TertiaryAttribute":null,"Payload":{"QuestionText":"Now, we'd like to ask you a series of brief questions focusing on your future actions. Specifically, we're interested in how you anticipate reacting to or engaging with the theory you mentioned at the start of this study. Please consider each statement in the context of your future encounters with this theory and indicate how you expect to act or respond.<br>","DefaultChoices":false,"DataExportTag":"Q113","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Now, we'd like to ask you a series of brief questions focusing on your future actions. Specifical...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswer
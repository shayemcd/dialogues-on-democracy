rivate":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"When presented with a social media campaign contradicting the theory you described, which of the...","Choices":{"1":{"Display":"Actively oppose it"},"2":{"Display":"Ignore it"},"3":{"Display":"Actively support it"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID136","RecodeValues":{"1":"-1","2":"0","3":"1"},"Randomization":{"Advanced":{"FixedOrder":["{~ScaleReversal~}","{~ScaleReversal~}","{~ScaleReversal~}"],"RandomSubSet":[],"RandomizeAll":[],"ScaleReversal":["1","2","3"],"TotalRandSubset":0,"Undisplayed":[]},"ConsistentScaleReversal":true,"EvenPresentation":false,"TotalRandSubset":"","Type":"Advanced"}}},{"SurveyID":"SV_39IRNTCn5hF9YDs","Element":"SQ","PrimaryAttribute":"QID31","SecondaryAttribute":"Which of the following best describes your political preference?","TertiaryAttribute":null,"Payload":{"ChoiceOrder":["1","2","3","4","5","6"],"Choices":{"1":{"Display":"Strongly Democratic"},"2":{"Display":"Democratic"},"3":{"Display":"Lean Democratic"},"4":{"Display":"Lean Republican"},"5":{"Display":"Republican"},"6":{"Display":"Strongly Republican"}},"Configuration":{"LabelPosition":"BELOW","QuestionDescriptionOption":"UseText"},"DataExportTag":"DemRep_C","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":7,"QuestionDescription":"Which of the following best describes your political preference?","QuestionID":"QID31","QuestionText":"Which of the following best describes your political\n      preference?","QuestionText_Unsafe":"Which of the following best describes your political\n      preference?","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}}}},{"SurveyID":"SV_39IRNTCn5hF9YDs","Element":"SQ","PrimaryAttribute":"QID154","SecondaryAttribute":"Who did you vote for in the 2020 Presidential Election?","TertiaryAttribute":null,"Payload":{"ChoiceOrder":["1","2","3","4","5","6","7"],"Choices":{"1":{"Display":"Joe Biden"},"2":{"Display":"Donald Trump"},"3":{"Display":"Other candidate"},"4":{"Display":"I did not vote for reasons outside of my control"},"5":{"Display":"I did not vote, but I could have"},"6":{"Display":"I did not vote out of protest"},"7":{"Display":"Prefer not to say"}},"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"VoteFor2020","DataVisibility":{"Hidden":false,"Private":false},"Language":[],"NextAnswerId":1,"NextChoiceId":8,"QuestionDescription":"Who did you vote for in the 2020 Presidential Election?","QuestionID":"QID154","QuestionText":"Who did you vote for in the 2020 Presidential Election?","QuestionText_Unsafe":"Who did you vote for in the 2020 Presidential Election?","QuestionType":"MC","RecodeValues":{"1":"-1","2":"1","3":"2","4":"3","5":"4","6":"5","7":"6"},"Selector":"SAVR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"RequestResponse","ForceResponseType":"RequestResponse","Type":"None"}}}},{"SurveyID":"SV_39IRNTCn5hF9YDs","Element":"SQ","PrimaryAttribute":"QID161","SecondaryAttribute":"Who do you think you will vote for in the 2024 Presidential Election?","TertiaryAttribute":null,"Payload":{"QuestionText":"Who do you think you will vote for in the 2024 Presidential Election?","DataExportTag":"VoteFor2024","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Who do you think you will vote for in the 2024 Presidential Election?","Choices":{"1":{"Display":"Joe Biden"},"2":{"Display":"Donald Trump"},"3":{"Display":"Other candidate"},"4":{"Display":"I won't vote for reasons outside of my control"},"5":{"Display":"I won't vote"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"RequestResponse","ForceResponseType":"RequestResponse","Type":"None"}},"RecodeValues":{"1":"-1","2":"1","3":"2","4":"3","5":"4"},"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionID":"QID161"}},{"SurveyID":"SV_39IRNTCn5hF9YDs","Element":"SQ","PrimaryAttribute":"QID153","SecondaryAttribute":"With which party are you registered?","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[1,2,3,"7","8",6],"Choices":{"1":{"Display":"Republican"},"2":{"Display":"Democrat"},"3":{"Display":"Independent"},"6":{"Display":"Other:","InputHeight":24,"InputWidth":326,"TextEntry":"true"},"7":{"Display":"Not registered with a specific political party"},"8":{"Display":"Not registered to vote"}},"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"PartyReg","DataVisibility":{"Hidden":false,"Private":false},"Language":[],"NextAnswerId":1,"NextChoiceId":9,"QuestionDescription":"With which party are you registered?","QuestionID":"QID153","QuestionText":"With which party are you registered?","QuestionText_Unsafe":"With which party are you registered?","QuestionType":"MC","RecodeValues":{"1":"1","2":"-1","3":"0","6":"4","7":"2","8":"3"},"Selector":"SAVR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"RequestResponse","ForceResponseType":"RequestResponse","Type":"None"}}}},{"SurveyID":"SV_39IRNTCn5hF9YDs","Element":"SQ","PrimaryAttribute":"QID183","SecondaryAttribute":"You are given a magic pill. If taken, it will eliminate all your political biases, causing you to...","TertiaryAttribute":null,"Payload":{"QuestionText":"You are given a magic pill. If taken, it will eliminate all your political biases, causing you to adopt an unpredictable set of (potentially) controversial and socially alienating political beliefs that are very different from (and truer than) the ones you have now. Do you take the pill?","DataExportTag":"MagicPill","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"You are given a magic pill. If taken, it will eliminate all your political biases, causing you to...","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"},"4":{"Display":"Reject question -- I expect my beliefs would mostly stay the same"},"5":{"Display":"Reject question, other reason","TextEntry":"true"},"6":{"Display":"Reject question -- I expect my new beliefs wouldn't be controversial or socially alienating"}},"ChoiceOrder":["1","2","4","6","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionID":"QID183"}},{"SurveyID":"SV_39IRNTCn5hF9YDs","Element":"SQ","PrimaryAttribute":"QID16","SecondaryAttribute":"You will now be participating in a conversation with an advanced AI about some of the events or t...","TertiaryAttribute":null,"Payload":{"QuestionText":"You will now be participating in a <b>conversation with an advanced AI<\/b> about some of the <b>events or topics that you have already answered questions about<\/b>. The purpose of this dialogue is to see how humans and AI can engage around complicated topics. Please be open and honest in your responses, and remember that the AI is neutral and non-judgmental. Your participation is confidential. Thank you for contributing to this study on AI and human interaction.","DefaultChoices":false,"DataExportTag":"treatmentInstruction","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"You will now be participating in a conversation with an advanced AI about some of the events or t...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID16","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/*Place your JavaScript here to run when the page loads*\/\n\t\n\t\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\nvar activeConditionNumber = Qualtrics.SurveyEngine.getEmbeddedData('activeConditionNumber');\n\nif (activeConditionNumber === '2') {\n    \/\/ Retrieve other variables for replacement\n    var response1 = Qualtrics.SurveyEngine.getEmbeddedData('userResponse_pt1');\n    var response2 = Qualtrics.SurveyEngine.getEmbeddedData('userResponse_pt2');\n\t\n    \/\/ Combine the responses with a space between them\n    var combinedResponse = response1 + \" \" + response2;\n\n    \/\/ Save the combined response as an embedded value\n    \/\/ The combined value can now be used later in the survey or for data analysis\n    Qualtrics.SurveyEngine.setEmbeddedData('userResponse', combinedResponse);\n}\n\t\n});\n\t\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_39IRNTCn5hF9YDs","Element":"SQ","PrimaryAttribute":"QID12","SecondaryAttribute":"You will now be participating in a conversation with an advanced AI about your views and experien...","TertiaryAttribute":null,"Payload":{"QuestionText":"You will now be participating in a conversation with an advanced AI about your views and experiences with firefighters. The purpose of this dialogue is to see how AI can engage around complicated topics. Please be open and honest in your responses, and remember that the AI is neutral and non-judgmental. Your participation is confidential. Thank you for contributing to this study on AI and human interaction.","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"You will now be participating in a conversation with an advanced AI about your views and experien...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"You will now be participating in a conversation with an advanced AI about your views and experiences with the American medical system. The purpose of this dialogue is to see how AI can engage around complicated topics. Please be open and honest in your responses, and remember that the AI is neutral and non-judgmental. Your participation is confidential. Thank you for contributing to this study on AI and human interaction.","DataExportTag":"Q12","QuestionID":"QID12","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_39IRNTCn5hF9YDs","Element":"SQ","PrimaryAttribute":"QID14","SecondaryAttribute":"You will now be participating in a conversation with an advanced AI about your views on pets -- p...","TertiaryAttribute":null,"Payload":{"QuestionText":"You will now be participating in a conversation with an advanced AI about your views on pets -- particularly, cats vs. dogs. The purpose of this dialogue is to see how AI can debate with human beings around various topics. Please be open and honest in your responses, and remember that the AI is neutral and non-judgmental. Your participation is confidential. Thank you for contributing to this study on AI and human interaction.","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"You will now be participating in a conversation with an advanced AI about your views on pets -- p...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"You will now be participating in a conversation with an advanced AI about your views and experiences with firefighters. The purpose of this dialogue is to see how AI can engage around complicated topics. Please be open and honest in your responses, and remember that the AI is neutral and non-judgmental. Your participation is confidential. Thank you for contributing to this study on AI and human interaction.","DataVisibility":{"Private":false,"Hidden":false},"DataExportTag":"Q14","QuestionID":"QID14"}},{"SurveyID":"SV_39IRNTCn5hF9YDs","Element":"SQ","PrimaryAttribute":"QID1718120409","SecondaryAttribute":"You will participate in a conversation with an advanced AI about some of the topics and ideas tha...","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[],"Configuration":{"QuestionDescriptionOption":"UseText"},"DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":4,"QuestionDescription":"You will participate in a conversation with an advanced AI about some of the topics and ideas tha...","QuestionJS":"\/\/ SETUP (before chatbot page)\n\nQualtrics.SurveyEngine.addOnload(function () {\n\t\/*Place your JavaScript here to run when the page loads*\/\n\n});\n\n\n\nQualtrics.SurveyEngine.addOnReady(function () {\n\t\n\t\/\/ clear variables in localStorage in case they somehow already exist\n\tlocalStorage.removeItem(\"chatParams\");\n\tlocalStorage.removeItem(\"responses\");\n\tlocalStorage.removeItem(\"appData\");\n\nvar response1 = localStorage.getItem(\"userResponse_pt1\")\nvar response2 = localStorage.getItem('userResponse_pt2');\n\n\/\/var response1 = Qualtrics.SurveyEngine.getEmbeddedData('userResponse_pt1');\n\/\/var response2 = Qualtrics.SurveyEngine.getEmbeddedData('userResponse_pt2');\n\t\n    \/\/ Combine the responses with a space between them\nvar combinedResponse = response1 + \" \" + response2;\n\t\nQualtrics.SurveyEngine.setEmbeddedData('userResponse', combinedResponse);\nconsole.log(combinedResponse);\n\t\n\tvar model = Qualtrics.SurveyEngine.getEmbeddedData('model');\n     console.log(model);\n\t\n\t\n\t\/\/ get relevant survey responses for constructing prompt\n\tlet responses = {};\t\n\tresponses['conspiracyTheory'] = \"${e:\/\/Field\/conRestatement}\";\n\tresponses['userBeliefLevel'] = \"${q:\/\/QID52\/TotalSum}\";\n\tresponses['values'] = localStorage.getItem(\"values\");  \n    responses['ElecRigged_Pre'] = \"${q:\/\/QID165\/TotalSum}\";\n    responses['combinedResponse'] = combinedResponse;\n\t\n\tlocalStorage.setItem(\"responses\", JSON.stringify(responses));\n\tconsole.log(\"chatbot_setup: responses\", responses);\n\n\t\n\t\n    \/\/ define chatbot parameters\n\tlet chatParams = {\n\t\tmodel: { \n\t\t\tname: model, \n\t\t\tbaseURL: \"https:\/\/openrouter.ai\/api\/v1\",\n\t        apiKeyEncrypted: \"ENCRYPTED_API_KEY_PLACEHOLDER\"\n\t  \t\t   },\n\t\tstudy: { maxUserMessages: 3, \n\t\t\t   sanitize: false},\n\t\tinitialMessages: [],  \/\/ specify below\n\t\tui: { preventPaste: true },\n\t\tappURL_: \"https:\/\/vegapunkdemo.vercel.app\"\n\t};\n\n\tvar baseSystemMessage = Qualtrics.SurveyEngine.getEmbeddedData('ChatbotPromptTemplate');\n\n    let systemPrompt = baseSystemMessage\n\t    .replace('{{ElecRigged_Pre}}',  responses.ElecRigged_Pre)\n\t\t.replace('{{conspiracyTheory}}',  responses.conspiracyTheory)\n\t\t.replace('{{userBeliefLevel}}',  responses.userBeliefLevel)\n\t    .replace('{{values}}', responses.values);\n\t\/\/ set up system prompt\/messages using survey responses\n\t\n\tlet initialMessages = [{ role: \"system\", content: systemPrompt}, \n\t\t\t\t\t\t   {role: \"user\", content: responses.combinedResponse}];\n\t\n\tchatParams['initialMessages'] = initialMessages;\n\t\n\t\/\/ save chatParams to localStorage\n\tlocalStorage.setItem(\"chatParams\", JSON.stringify(chatParams));\n\tconsole.log(\"chatParams\", chatParams);\n\n});","QuestionText":"You will participate in a <u>conversation with an advanced AI<\/u> about some of the <u>topics and ideas that you have already answered questions about<\/u>. The purpose of this dialogue is to see how humans and AI can engage around complicated topics.<br \/>\n<br \/>\nPlease be open and honest in your responses, and remember that the AI is neutral and non-judgmental. Your participation is confidential. Thank you for contributing to this study on AI and human interaction.","QuestionText_Unsafe":"You will participate in a <u>conversation with an advanced AI<\/u> about some of the <u>topics and ideas that you have already answered questions about<\/u>. The purpose of this dialogue is to see how humans and AI can engage around complicated topics.<br \/>\n<br \/>\nPlease be open and honest in your responses, and remember that the AI is neutral and non-judgmental. Your participation is confidential. Thank you for contributing to this study on AI and human interaction.","QuestionType":"DB","Selector":"TB","Validation":{"Settings":{"Type":"None"}},"DataExportTag":"Q1","QuestionID":"QID1718120409"}},{"SurveyID":"SV_39IRNTCn5hF9YDs","Element":"SQ","PrimaryAttribute":"QID10","SecondaryAttribute":"[insert expert disagreement prompt here] You will now be participating in a conversation with an...","TertiaryAttribute":null,"Payload":{"QuestionText":"[insert expert disagreement prompt here]<br><br>You will now be participating in a conversation with an advanced AI about your concerns about the upcoming U.S. presidential elections. The purpose of this dialogue is to see how AI can engage around complicated topics. Please be open and honest in your responses, and remember that the AI is neutral and non-judgmental. Your participation is confidential. Thank you for contributing to this study on AI and human interaction.","DefaultChoices":false,"DataExportTag":"electInstructs","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"[insert expert disagreement prompt here] You will now be participating in a conversation with an...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID10","DataVisibility":{"Private":false,"Hidden":false}}}]}
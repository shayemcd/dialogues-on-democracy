    \/\/ Assume there is a div with an ID of 'gptResponseContainer' in your question\n    document.getElementById('GPT_PetitionContainer').innerHTML = formattedResponse;\n\t\n\tjQuery(\"#\"+this.questionId+\" textarea,input[type=text]\").on(\"paste\", function(e) { e.preventDefault(); });\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DefaultChoices":false,"DataExportTag":"Petition","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Below is a summary of a petition related to the theory you provided at the beginning of this expe...","Choices":{"1":{"Display":"No"},"2":{"Display":"Yes"}},"ChoiceOrder":["1","2"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID149","RecodeValues":{"1":"0","2":"1"}}},{"SurveyID":"SV_39IRNTCn5hF9YDs","Element":"SQ","PrimaryAttribute":"QID150","SecondaryAttribute":"Below is a summary of a petition related to the theory you provided at the beginning of this expe...","TertiaryAttribute":null,"Payload":{"QuestionText":"<style>\n  #GPT_PetitionContainer {\n    font-family: 'Times New Roman', serif;\n  }\n<\/style>\n\n<br><b>Below is a summary of a petition related to the theory you provided at the beginning of this experiment. Would you like to publicly sign this petition?<\/b><br>\n\n<span id=\"GPT_PetitionContainer\"><\/span>\n\n<br><br><b>Having read it, would you like to sign this petition?<\/b><br>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n    \/\/ Retrieve the GPT-4 response from an embedded data field\n    var GPT_Petition = Qualtrics.SurveyEngine.getEmbeddedData('GPTPetition');\n\n    \/\/ Replace newline characters with HTML line break tags\n    var formattedResponse = GPT_Petition.replace(\/\\n\/g, '<br>');\n\n    \/\/ Insert the formatted response into an HTML element in your survey\n    \/\/ Assume there is a div with an ID of 'gptResponseContainer' in your question\n    document.getElementById('GPT_PetitionContainer').innerHTML = formattedResponse;\n\t\n\tjQuery(\"#\"+this.questionId+\" textarea,input[type=text]\").on(\"paste\", function(e) { e.preventDefault(); });\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DefaultChoices":false,"DataExportTag":"Q140","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Below is a summary of a petition related to the theory you provided at the beginning of this expe...","Choices":{"1":{"Display":"No"},"2":{"Display":"Yes"}},"ChoiceOrder":["1","2"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID150"}},{"SurveyID":"SV_39IRNTCn5hF9YDs","Element":"SQ","PrimaryAttribute":"QID17","SecondaryAttribute":"Browser Meta Info","TertiaryAttribute":null,"Payload":{"Choices":{"1":{"Display":"Browser","TextEntry":1},"2":{"Display":"Version","TextEntry":1},"3":{"Display":"Operating System","TextEntry":1},"4":{"Display":"Screen Resolution","TextEntry":1},"5":{"Display":"Flash Version","TextEntry":1},"6":{"Display":"Java Support","TextEntry":1},"7":{"Display":"User Agent","TextEntry":1}},"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"MetaInfo","DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":4,"QuestionDescription":"Browser Meta Info","QuestionID":"QID17","QuestionText":"Browser Meta Info","QuestionText_Unsafe":"Browser Meta Info","QuestionType":"Meta","Selector":"Browser"}},{"SurveyID":"SV_39IRNTCn5hF9YDs","Element":"SQ","PrimaryAttribute":"QID23","SecondaryAttribute":"Choose one or more races that you consider yourself to be:","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[1,2,3,4,5,6],"Choices":{"1":{"Display":"White"},"2":{"Display":"Black or African American"},"3":{"Display":"American Indian or Alaska Native"},"4":{"Display":"Asian"},"5":{"Display":"Native Hawaiian or Pacific Islander"},"6":{"Display":"Other","TextEntry":"true"}},"Configuration":{"NumColumns":2,"QuestionDescriptionOption":"UseText"},"DataExportTag":"Race","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":7,"QuestionDescription":"Choose one or more races that you consider yourself to be:","QuestionID":"QID23","QuestionText":"<p>Choose one or more races that you consider yourself to be:<\/p>","QuestionText_Unsafe":"<p>Choose one or more races that you consider yourself to be:<\/p>","QuestionType":"MC","Selector":"MAVR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"RequestResponse","ForceResponseType":"RequestResponse","Type":"None"}}}},{"SurveyID":"SV_39IRNTCn5hF9YDs","Element":"SQ","PrimaryAttribute":"QID65","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DataExportTag":"Q55","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID65"}},{"SurveyID":"SV_39IRNTCn5hF9YDs","Element":"SQ","PrimaryAttribute":"QID105","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"Q95","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID105","QuestionJS":"function sendChatToOpenAI(systemMessage, userMessage, onSuccess, onError) {\n    var apiKey = Qualtrics.SurveyEngine.getEmbeddedData('OpenAIKey');\n\n    var xhr = new XMLHttpRequest();\n    xhr.open(\"POST\", \"https:\/\/api.openai.com\/v1\/chat\/completions\");\n    xhr.setRequestHeader(\"Content-Type\", \"application\/json\");\n    xhr.setRequestHeader(\"Authorization\", apiKey);\n\n    xhr.onreadystatechange = function () {\n        if (xhr.readyState === XMLHttpRequest.DONE) { \/\/ Simplified check\n\t\n            if (xhr.status === 200) {\n                var response = JSON.parse(xhr.responseText);\n                var gptResponse = response.choices[0].message.content;\n                Qualtrics.SurveyEngine.setEmbeddedData('infoSearchLinks', gptResponse);\n                onSuccess(gptResponse);\n\t\t\t\t\n            } else {\n                console.error(\"Error from OpenAI:\", xhr.responseText);\n                onError(\"Error: \" + xhr.status);\n                Qualtrics.SurveyEngine.setEmbeddedData('infoSearchLinks', xhr.status);\n            }\n\t\t         document.getElementById('loadingMessage').style.display = 'none'; \/\/ Hide loading message\n\t\t\t\t document.getElementById('loadingSpinner').style.display = 'none'; \/\/ Hide loading spinner\n\t \t         document.getElementById('finishedMessage').style.display = 'block'; \/\/ show finished loading message\n\t\t         document.querySelector('.NextButton').style.display = ''; \/\/ Show the Next button\n        }\n    };\n\n    var data = JSON.stringify({\n        model: \"gpt-4-0125-preview\", \n        messages: conversationHistory\n    });\n\n    xhr.send(data);\n}\n\n\/\/ Example usage\n\nvar systemMessage  = Qualtrics.SurveyEngine.getEmbeddedData('embedsystemMessage');\nvar userFirstResponse = Qualtrics.SurveyEngine.getEmbeddedData('userResponse');\nvar gptFirstResponse = Qualtrics.SurveyEngine.getEmbeddedData('GPTResponse');\nvar userSecondResponse = Qualtrics.SurveyEngine.getEmbeddedData('userSecondResponse');\nvar gptSecondResponse = Qualtrics.SurveyEngine.getEmbeddedData('GPTResponse2');\nvar userThirdResponse = Qualtrics.SurveyEngine.getEmbeddedData('userThirdResponse');\nvar gptThirdResponse = Qualtrics.SurveyEngine.getEmbeddedData('GPTResponse3');\n\n\nvar conversationHistory = [\n    {\"role\": \"system\", \"content\": systemMessage},\n    {\"role\": \"user\", \"content\": userFirstResponse},\n    {\"role\": \"assistant\", \"content\": gptFirstResponse},\n    {\"role\": \"user\", \"content\": userSecondResponse}, \n\t{\"role\": \"assistant\", \"content\": gptSecondResponse},\n    {\"role\": \"user\", \"content\": userThirdResponse}, \n\t{\"role\": \"assistant\", \"content\": gptThirdResponse},\n\n];\n\nvar systemMessageInfoSearch  = Qualtrics.SurveyEngine.getEmbeddedData('informationSearchPrompt');\n\n\nsendChatToOpenAI(systemMessageInfoSearch, conversationHistory, function(response) {\n    console.log(\"OpenAI says:\", response);\n}, function(error) {\n    console.log(error);\n});"}},{"SurveyID":"SV_39IRNTCn5hF9YDs","Element":"SQ","PrimaryAttribute":"QID113","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the
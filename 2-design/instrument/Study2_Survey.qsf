ads*\/\njQuery(\"#Buttons\").hide();\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","QuestionText":"<div style=\"text-align: center;\"><img src=\"https:\/\/uregina.eu.qualtrics.com\/CP\/Graphic.php?IM=IM_3shrQCRnfBZUQqF\" style=\"width: 325px; height: 325px;\" \/><\/div>","QuestionText_Unsafe":"<div style=\"text-align: center;\"><img src=\"https:\/\/uregina.eu.qualtrics.com\/CP\/Graphic.php?IM=IM_3shrQCRnfBZUQqF\" style=\"width: 325px; height: 325px;\" \/><\/div>","QuestionType":"DB","Selector":"TB","Validation":{"Settings":{"Type":"None"}}}},{"SurveyID":"SV_39IRNTCn5hF9YDs","Element":"SQ","PrimaryAttribute":"QID101","SecondaryAttribute":" ","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[],"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"centipede","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":4,"QuestionDescription":" ","QuestionID":"QID101","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/*Place your JavaScript here to run when the page loads*\/\njQuery(\"#Buttons\").hide();\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","QuestionText":"<div style=\"text-align: center;\"><img src=\"https:\/\/uregina.eu.qualtrics.com\/CP\/Graphic.php?IM=IM_9ABnbqPl4IHibjf\" style=\"width: 325px; height: 325px;\" \/><\/div>","QuestionText_Unsafe":"<div style=\"text-align: center;\"><img src=\"https:\/\/uregina.eu.qualtrics.com\/CP\/Graphic.php?IM=IM_9ABnbqPl4IHibjf\" style=\"width: 325px; height: 325px;\" \/><\/div>","QuestionType":"DB","Selector":"TB","Validation":{"Settings":{"Type":"None"}}}},{"SurveyID":"SV_39IRNTCn5hF9YDs","Element":"SQ","PrimaryAttribute":"QID1718120412","SecondaryAttribute":" ","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[],"Configuration":{"QuestionDescriptionOption":"UseText"},"DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":4,"QuestionDescription":" ","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\t\n\t\/\/ ========== WARNING: DO NOT MODIFY ANYTHING BELOW UNNECESSARILY =====================\n\t\n\tlet self = this; \n\tlet chatParamsJson = localStorage.getItem('chatParams');\n    let chatParams = JSON.parse(chatParamsJson);\n\tlocalStorage.setItem(\"appData\", []);  \/\/ ensure dataToSave is empty initially\n\t\n\t\/\/ set iframe src\n\tdocument.getElementById(\"chatframe\").src = chatParams.appURL_;\n\t\n\t\/\/ styling\n\tself.disableNextButton();\n\tself.hideNextButton();\n\tconst skinInner = document.querySelectorAll(\".SkinInner\")[0];  \n\tif (skinInner) skinInner.style.paddingTop = \"10px\";  \/\/ reduce padding\/allow more room for chatbot\n\t\t\n\tconst messageEventListener = (event) => {\n\t\t\n\t\tif (event.origin !== chatParams.appURL_) return; \n\t\t\n\t\tlet appData = JSON.parse(event.data);\n\t\tlet nextSection = false;\n\t\t\/\/ console.log(\"qualtrics: data from app\", appData);\n\n\t\tif (appData.requestData) {  \/\/ app is requesting chatParams: { requestData: true }\n\t\t\tconsole.log(\"qualtrics: sending chatParamsJson to iframe\");\n\t\t\tconst iframe = document.querySelector(\"iframe\");\n\t\t\tiframe.contentWindow.postMessage(chatParamsJson, '*');\n\t\t\treturn;\n\t\t} else if (appData.constructor === Array) {  \/\/ app sent chat history and other data: [\"\", \"\", \"\"] \n\t\t\tconsole.log(\"qualtrics: saving appData to localStorage\");\n\t\t\tlocalStorage.setItem(\"appData\", JSON.stringify(appData));\n\t\t\tconst appDataObj = JSON.parse(appData.join(\"\"));\n\t\t\tnextSection = appDataObj.nextSection;\t\n\t\t\t\n\t\t\t\/\/ save partial data as embedded data\n\t\t\ttry {\n\t\t\t\tQualtrics.SurveyEngine.setJSEmbeddedData(\"chatPartialData\", JSON.stringify(appData));\n\t\t\t} catch (error) {\n\t\t\t\tconsole.error(\"qualtrics: error saving embedded data chatPartialData\");\n\t\t\t}\n\t\t}\n\t\n\t\tif (nextSection) {\n\t\t\tconsole.log(\"enable next button\");\n\t\t\tself.enableNextButton();\n\t\t\tself.showNextButton();\n\t\t\twindow.removeEventListener('message', messageEventListener);\n\t\t\tlocalStorage.removeItem(\"chatParams\");\n\t\t\tconsole.log(\"remove listener\\n====================================\");\n\t\t}\n\n\t}\n\n\twindow.addEventListener('message', messageEventListener);\n\t\n\t\t\n});","QuestionText":"<iframe id=\"chatframe\" style=\"border:none;width:95vw;height:85vh\" title=\"\"><\/iframe>","QuestionText_Unsafe":"<iframe id=\"chatbot\" src=\"https:\/\/sveltekit-vercel-chatbot.vercel.app\/\" style=\"border:none;width:95vw;height:85vh\" title=\"\"><\/iframe>","QuestionType":"DB","Selector":"TB","Validation":{"Settings":{"Type":"None"}},"DataExportTag":"Q2","QuestionID":"QID1718120412"}},{"SurveyID":"SV_39IRNTCn5hF9YDs","Element":"SQ","PrimaryAttribute":"QID108","SecondaryAttribute":"${e:\/\/Field\/Article1Description} Read more ${e:\/\/Field\/Article2Description} Read more","TertiaryAttribute":null,"Payload":{"QuestionText":"<div id=\"newsContainer\" style=\"display: flex; justify-content: space-between; gap: 60px;\"> \n    \n    <div class=\"article\" style=\"width: 48%; padding: 10px; border: 1px solid #ccc; border-radius: 10px; background-color: #f9f9f9;\"> \n        <img id=\"article1Image\" src=\"\" alt=\"Article Image\" style=\"width:100%; max-height: 300px; object-fit: cover; border-radius: 8px;\"> \n        <h3 id=\"article1Title\" style=\"font-size: 1.2em;\"><\/h3> \n        <p>${e:\/\/Field\/Article1Description}<\/p>\n        <p><small id=\"article1Source\" style=\"font-size: 0.8em;\"><\/small><\/p>\n        <a id=\"article1Link\" href=\"\" target=\"_blank\">Read more<\/a>\n    <\/div>\n\n    \n    <div class=\"article\" style=\"width: 48%; padding: 10px; border: 1px solid #ccc; border-radius: 10px; background-color: #f9f9f9;\"> \n        <img id=\"article2Image\" src=\"\" alt=\"Article Image\" style=\"width:100%; max-height: 300px; object-fit: cover; border-radius: 8px;\"> \n        <h3 id=\"article2Title\" style=\"font-size: 1.2em;\"><\/h3> \n        <p>${e:\/\/Field\/Article2Description}<\/p>\n        <p><small id=\"article2Source\" style=\"font-size: 0.8em;\"><\/small><\/p>\n        <a id=\"article2Link\" href=\"\" target=\"_blank\">Read more<\/a>\n    <\/div>\n<\/div>","DefaultChoices":false,"DataExportTag":"News Article Show","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"${e:\/\/Field\/Article1Description} Read more ${e:\/\/Field\/Article2Description} Read more","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID108","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/*Place your JavaScript here to run when the page loads*\/\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function() {\n\t\n\t\n    \/\/ Article 1\n    document.getElementById('article1Title').textContent = \"${e:\/\/Field\/Article1Title}\";\n\t\t\n\/\/\tvar Article1Description = \"${e:\/\/Field\/Article1Description}\"\n\/\/\tdocument.getElementById('article1Description').textContent = Article1Description\n\t\n    document.getElementById('article1Image').src = \"${e:\/\/Field\/Article1Image}\";\n    document.getElementById('article1Link').href = \"${e:\/\/Field\/Article1Url}\";\n    document.getElementById('article1Source').textContent = \"Source: \" + \"${e:\/\/Field\/Article1Source}\";\n\n    \/\/ Article 2\n    document.getElementById('article2Title').textContent = \"${e:\/\/Field\/Article2Title}\";\n\n\t\n\/\/\tvar Article2Description = \"${e:\/\/Field\/Article2Description}\"\n\/\/\tdocument.getElementById('article2Description').textContent = Article2Description\n\n    document.getElementById('article2Image').src = \"${e:\/\/Field\/Article2Image}\";\n    document.getElementById('article2Link').href = \"${e:\/\/Field\/Article2Url}\";\n    document.getElementById('article2Source').textContent = \"Source: \" + \"${e:\/\/Field\/Article2Source}\";\n\t\n\t    \/\/ Function to handle the click event\n    function handleLinkClick(event, articleId) {\n    \/\/    event.preventDefault(); \/\/ Prevent the default link action (optional, for demonstration)\n        console.log(\"Link for Article \" + articleId + \" was clicked.\"); \/\/ For debugging, replace with your logging method\n\n        \/\/ Example: Save a flag as embedded data in Qualtrics (Note: This requires custom logic to actually save back to Qualtrics, as direct saving like this won't work out of the box)\n        Qualtrics.SurveyEngine.setEmbeddedData('Article' + articleId + 'Clicked', 'true');\n\n        \/\/ Optionally navigate to the link after logging the click or performing other actions\n        \/\/ window.location.href = event.currentTarget.href;\n    }\n\n    \/\/ Attach event listeners to the \"Read more\" links\n    document.getElementById('article1Link').addEventListener('click', function(event) {\n        handleLinkClick(event, 1);\n    });\n    document.getElementById('article2Link').addEventListener('click', function(event) {\n        handleLinkClick(event, 2);\n    });\n\t\n    \/\/ Capture the start time when the page is ready\n    var startTime = Date.now();\n\n    \/\/ Function to capture clicks and their timing\n    var clicks = []; \/\/ Store the time of clicks\n\n    function recordClick() {\n        var clickTime = Date.now() - startTime;\n        clicks.push(clickTime);\n\n        \/\/ Optionally, save each click's time immediately if needed\n        if (clicks.length === 1) {\n            Qualtrics.SurveyEngine.setEmbeddedData('TimeAtClick1', clickTime);\n        } else if (clicks.length === 2) {\n            Qualtrics.SurveyEngine.setEmbeddedData('TimeAtClick2', clickTime);\n        }\n    }\n\n    \/\/ Attach event listeners to \"Read more\" links\n    document.getElementById('article1Link').addEventListener('click', recordClick);\n    document.getElementById('article2Link').addEventListener('click', recordClick);\n\n    \/\/ Before moving to the next page, save total time spent on the page and times of clicks\n    Qualtrics.SurveyEngine.addOnPageSubmit(function() {\n        var totalTimeSpent = Date.now() - startTime;\n        Qualtrics.SurveyEngine.setEmbeddedData('TotalTimeSpent', totalTimeSpent);\n\n        \/\/ If clicks were not registered, set default values\n        if (clicks.length === 0) {\n            Qualtrics.SurveyEngine.setEmbeddedData('TimeAtClick1', 'N\/A');\n            Qualtrics.SurveyEngine.setEmbeddedData('TimeAtClick2', 'N\/A');\n        } else if (clicks.length === 1) {\n            \/\/ If only one click was registered, ensure the second click time is set as 'N\/A'\n            Qualtrics.SurveyEngine.setEmbeddedData('TimeAtClick2', 'N\/A');\n        }\n    });\n\n\t\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});"}},{"SurveyID":"SV_39IRNTCn5hF9YDs","Element":"SQ","PrimaryAttribute":"QID68","SecondaryAttribute":".","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[],"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"Preload","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":4,"QuestionDescription":".","QuestionID":"QID68","QuestionText":"<span style=\"color:#ffffff;\">.<\/span>\n<link as=\"image\" href=\"https:\/\/uregina.eu.qualtrics.com\/ControlPanel
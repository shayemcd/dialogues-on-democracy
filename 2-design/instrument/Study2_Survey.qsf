(function() {\n    this.hideNextButton();\n    document.getElementById('loadingMessage').style.display = 'block'; \/\/ Show loading message\n\tdocument.getElementById('loadingSpinner').style.display = 'block'; \/\/ Show loading spinner\n});\n\n\nfunction sendChatToOpenAI(systemMessage, userMessage, onSuccess, onError) {\n    var apiKey = Qualtrics.SurveyEngine.getEmbeddedData('OpenAIKey');\n\n    var xhr = new XMLHttpRequest();\n    xhr.open(\"POST\", \"https:\/\/api.openai.com\/v1\/chat\/completions\");\n    xhr.setRequestHeader(\"Content-Type\", \"application\/json\");\n    xhr.setRequestHeader(\"Authorization\", apiKey);\n\n    xhr.onreadystatechange = function () {\n        if (xhr.readyState === XMLHttpRequest.DONE) { \/\/ Simplified check\n\t\n            if (xhr.status === 200) {\n                var response = JSON.parse(xhr.responseText);\n                var gptResponse = response.choices[0].message.content;\n                Qualtrics.SurveyEngine.setEmbeddedData('GPTResponse3', gptResponse);\n                onSuccess(gptResponse);\n\t\t\t\t\n            } else {\n                console.error(\"Error from OpenAI:\", xhr.responseText);\n                onError(\"Error: \" + xhr.status);\n                Qualtrics.SurveyEngine.setEmbeddedData('GPTResponse3', xhr.status);\n            }\n\t\t         document.getElementById('loadingMessage').style.display = 'none'; \/\/ Hide loading message\n\t\t\t\t document.getElementById('loadingSpinner').style.display = 'none'; \/\/ Hide loading spinner\n\t \t         document.getElementById('finishedMessage').style.display = 'block'; \/\/ show finished loading message\n\t\t         document.querySelector('.NextButton').style.display = ''; \/\/ Show the Next button\n        }\n    };\n\t\n\t\n    var OAI_model = Qualtrics.SurveyEngine.getEmbeddedData('model');\n    console.log(\"Model: \", OAI_model);\n\n\n    var data = JSON.stringify({\n        model: OAI_model,\n        messages: conversationHistory\n    });\n\n    xhr.send(data);\n}\n\n\/\/ Example usage\nvar systemMessage  = Qualtrics.SurveyEngine.getEmbeddedData('embedsystemMessage');\n\nvar userFirstResponse = Qualtrics.SurveyEngine.getEmbeddedData('userResponse');\nvar gptFirstResponse = Qualtrics.SurveyEngine.getEmbeddedData('GPTResponse');\nvar userSecondResponse = Qualtrics.SurveyEngine.getEmbeddedData('userSecondResponse');\nvar gptSecondResponse = Qualtrics.SurveyEngine.getEmbeddedData('GPTResponse2');\nvar userThirdResponse = Qualtrics.SurveyEngine.getEmbeddedData('userThirdResponse');\n\nvar conversationHistory = [\n    {\"role\": \"system\", \"content\": systemMessage},\n    {\"role\": \"user\", \"content\": userFirstResponse},\n    {\"role\": \"assistant\", \"content\": gptFirstResponse},\n    {\"role\": \"user\", \"content\": userSecondResponse}, \n\t{\"role\": \"assistant\", \"content\": gptSecondResponse},\n    {\"role\": \"user\", \"content\": userThirdResponse}, \n\n];\n\nsendChatToOpenAI(conversationHistory, function(response) {\n    console.log(\"OpenAI says:\", response);\n}, function(error) {\n    console.log(error);\n});","DataVisibility":{"Private":false,"Hidden":false},"QuestionText_Unsafe":"testing round 2<br><br><br>\n\n<div id=\"loadingMessage\" style=\"display: none;\">\n    <p>Please wait, processing your response...<\/p>\n    \n<\/div>","DataExportTag":"Q8","QuestionID":"QID8"}},{"SurveyID":"SV_39IRNTCn5hF9YDs","Element":"SQ","PrimaryAttribute":"QID106","SecondaryAttribute":"The next page may take a moment to load. Please do not refresh your browser or leave the page. Al...","TertiaryAttribute":null,"Payload":{"QuestionText":"<style>\n.spinner {\n  border: 4px solid rgba(0, 0, 0, 0.1);\n  width: 36px;\n  height: 36px;\n  border-radius: 50%;\n  border-left-color: #09f;\n  animation: spin 1s ease infinite;\n\n  \/* Centering styles *\/\n  position: absolute; \/* Use absolute positioning within a relative container *\/\n  top: 50%; \/* Position the top edge of the spinner in the middle of the container *\/\n  left: 50%; \/* Position the left edge of the spinner in the middle of the container *\/\n  transform: translate(-50%, -50%); \/* Offset the spinner by half its width and height to center it *\/\n}\n\n\/* Make sure the parent container has a relative position *\/\n#parentContainer {\n  position: relative;\n}\n\n@keyframes spin {\n  0% {\n    transform: rotate(0deg);\n  }\n  100% {\n    transform: rotate(360deg);\n  }\n}\n<\/style>\n\n<div id=\"loadingMessage\" style=\"display: none;\">\n    <p> The next page may take a moment to load. Please do not refresh your browser or leave the page. <\/p>\n    \n<\/div>\n\n<div id=\"finishedMessage\" style=\"display: none;\">\n    <p>All set! Please proceed by clicking the arrow button.<\/p>\n    \n<\/div>\n\n<div id=\"loadingSpinner\" class=\"spinner\" style=\"display:none;\"><\/div>","DefaultChoices":false,"DataExportTag":"infoSearchGPT_Active","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"The next page may take a moment to load. Please do not refresh your browser or leave the page. Al...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID106","QuestionJS":"\/\/ Hide the Next button initially and show a loading message\nQualtrics.SurveyEngine.addOnload(function() {\n    this.hideNextButton();\n    document.getElementById('loadingMessage').style.display = 'block'; \/\/ Show loading message\n\tdocument.getElementById('loadingSpinner').style.display = 'block'; \/\/ Show loading spinner\n});\n\nfunction sendSummaryToGPT(onSuccess, onError) {\n    var apiKey = Qualtrics.SurveyEngine.getEmbeddedData('OpenAIKey');\n\n    \/\/ Collect embedded values\n    var systemMessage = Qualtrics.SurveyEngine.getEmbeddedData('embedsystemMessage');\n    var userFirstResponse = Qualtrics.SurveyEngine.getEmbeddedData('userResponse');\n    var gptFirstResponse = Qualtrics.SurveyEngine.getEmbeddedData('GPTResponse');\n    var userSecondResponse = Qualtrics.SurveyEngine.getEmbeddedData('userSecondResponse');\n    var gptSecondResponse = Qualtrics.SurveyEngine.getEmbeddedData('GPTResponse2');\n    var userThirdResponse = Qualtrics.SurveyEngine.getEmbeddedData('userThirdResponse');\n    var gptThirdResponse = Qualtrics.SurveyEngine.getEmbeddedData('GPTResponse3');\n    \n    \/\/ Build the conversation summary\n    var conversationSummary =\n                              \"User's first response: \" + userFirstResponse + \"\\n\" +\n                              \"GPT's first response: \" + gptFirstResponse + \"\\n\" +\n                              \"User's second response: \" + userSecondResponse + \"\\n\" +\n                              \"GPT's second response: \" + gptSecondResponse + \"\\n\" +\n                              \"User's third response: \" + userThirdResponse + \"\\n\" +\n                              \"GPT's third response: \" + gptThirdResponse + \"\\n\\n\" +\n                              \"Based on this conversation, generate a GNews search term that will return a list of accurate, well-researched information concerning the conspiracy theory being debunked in the discussion you have just seen. Keep the search term short, or else no news articles will match. Do not separate different components with a comma or semicolon, use special characters, or enclose the terms in quotation marks. Link together disparate keywords, if you must, with (1) AND or (2) OR operators. For instance, you might write: JFK AND Warren Commission. Use no more than 3 words.\"\n\t;\n\n\t\t\n    var xhr = new XMLHttpRequest();\n    xhr.open(\"POST\", \"https:\/\/api.openai.com\/v1\/chat\/completions\");\n    xhr.setRequestHeader(\"Content-Type\", \"application\/json\");\n    xhr.setRequestHeader(\"Authorization\", apiKey);\n\n    xhr.onreadystatechange = function () {\n        if (xhr.readyState === XMLHttpRequest.DONE) {\n            if (xhr.status === 200) {\n                var response = JSON.parse(xhr.responseText);\n                var gptResponse = response.choices[0].message.content;\n                Qualtrics.SurveyEngine.setEmbeddedData('infoSearchLinks', gptResponse);\n                onSuccess(gptResponse);\n            } else {\n                console.error(\"Error from OpenAI:\", xhr.responseText);\n                onError(\"Error: \" + xhr.status);\n            }\n            document.getElementById('loadingMessage').style.display = 'none';\n            document.getElementById('loadingSpinner').style.display = 'none';\n            document.getElementById('finishedMessage').style.display = 'block';\n            document.querySelector('.NextButton').style.display = '';\n        }\n    };\n\n    var data = JSON.stringify({\n        model: \"gpt-4-0125-preview\",\n        messages: [{\"role\": \"system\", \"content\": conversationSummary}]\n    });\n\n    xhr.send(data);\n}\n\n\/\/ Example usage\nsendSummaryToGPT(function(response) {\n    console.log(\"GPT's response:\", response);\n}, function(error) {\n    console.log(\"Error:\", error);\n});"}},{"SurveyID":"SV_39IRNTCn5hF9YDs","Element":"SQ","PrimaryAttribute":"QID109","SecondaryAttribute":"The next page may take a moment to load. Please do not refresh your browser or leave the page. Al...","TertiaryAttribute":null,"Payload":{"QuestionText":"<style>\n.spinner {\n  border: 4px solid rgba(0, 0, 0, 0.1);\n  width: 36px;\n  height: 36px;\n  border-radius: 50%;\n  border-left-color: #09f;\n  animation: spin 1s ease infinite;\n\n  \/* Centering styles *\/\n  position: absolute; \/* Use absolute positioning within a relative container *\/\n  top: 50%; \/* Position the top edge of the spinner in the middle of the container *\/\n  left: 50%; \/* Position the left edge of the spinner in the middle of the container *\/\n  transform: translate(-50%, -50%); \/* Offset the spinner by half its width and height to center it *\/\n}\n\n\/* Make sure the parent container has a relative position *\/\n#parentContainer {\n  position: relative;\n}\n\n@keyframes spin {\n  0% {\n    transform: rotate(0deg);\n  }\n  100% {\n    transform: rotate(360deg);\n  }\n}\n<\/style>\n\n<div id=\"loadingMessage\" style=\"display: none;\">\n    <p> The next page may take a moment to load. Please do not refresh your browser or leave the page. <\/p>\n    \n<\/div>\n\n<div id=\"finishedMessage\" style=\"display: none;\">\n    <p>All set! Please proceed by clicking the arrow button.<\/p>\n    \n<\/div>\n\n<div id=\"loadingSpinner\" class=\"spinner\" style=\"display:none;\"><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"The next page may take a moment to load. Please do not refresh your browser or leave the page. Al...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionJS":"\/\/ Hide the Next button initially and show a loading message\nQualtrics.SurveyEngine.addOnload(function() {\n    this.hideNextButton();\n    document.getElementById('loadingMessage').style.display = 'block'; \/\/ Show loading message\n\tdocument.getElementById('loadingSpinner').style.display = 'block'; \/\/ Show loading spinner\n});\n\nfunction sendSummaryToGPT(onSuccess, onError) {\n    var apiKey = Qualtrics.SurveyEngine.getEmbeddedData('OpenAIKey');\n\n    \/\/ Collect embedded values\n\t\n\tvar conspiracyTheory = Qualtrics.SurveyEngine.getEmbeddedData('conspiracyTheory');\n\t\n  \/\/  var systemMessage = Qualtrics.SurveyEngine.getEmbeddedData('embedsystemMessage');\n  \/\/  var userFirstResponse = Qualtrics.SurveyEngine.getEmbeddedData('userResponse');\n  \/\/  var gptFirstResponse = Qualtrics.SurveyEngine.getEmbeddedData('GPTResponse');\n  \/\/  var userSecondResponse = Qualtrics.SurveyEngine.getEmbeddedData('userSecondResponse');\n \/\/   var gptSecondResponse = Qualtrics.SurveyEngine.getEmbeddedData('GPTResponse2');\n  \/\/  var userThirdResponse = Qualtrics.SurveyEngine.getEmbeddedData('userThirdResponse');\n  \/\/  var gptThirdResponse = Qualtrics.SurveyEngine.getEmbeddedData('GPTResponse3');\n    \n    \/\/ Build the conversation summary\n    var conversationSummary =\n                              \"Conspiracy theory: \" + conspiracyTheory + \"\\n\\n\" +\n                              \"System Task: Generate a GNews search term that will return a list of accurate, well-researched information pertaining to this conspiracy theory. Keep the search term short, or else no news articles will match. Do not separate different components with a comma or semicolon, use special characters, or enclose the terms in quotation marks. Link together disparate keywords, if you must, with (1) AND or (2) OR operators. For instance, you might write: JFK AND Warren Commission. Use no more than 3 words.\"\n\t;\n\n\t\t\n    var xhr = new XMLHttpRequest();\n    xhr.open(\"POST\", \"https:\/\/api.openai.com\/v1\/chat\/completions\");\n    xhr.setRequestHeader(\"Content-Type\", \"application\/json\");\n    xhr.setRequestHeader(\"Authorization\", apiKey);\n\n    xhr.onreadystatechange = function () {\n        if (xhr.readyState === XMLHttpRequest.DONE) {\n            if (xhr.status === 200) {\n                var response = JSON.parse(xhr.responseText);\n                var gptResponse = response.choices[0].message.content;\n                Qualtrics.SurveyEngine.setEmbeddedData('infoSearchLinks', gptResponse);\n                onSuccess(gptResponse);\n            } else {\n                console.error(\"Error from OpenAI:\", xhr.responseText);\n                onError(\"Error: \" + xhr.status);\n            }\n            document.getElementById('loadingMessage').style.display = 'none';\n            document.getElementById('loadingSpinner').style.display = 'none';\n            document.getElementById('finishedMessage').style.display = 'block';\n            document.querySelector('.NextButton').style.display = '';\n        }\n    };\n\n    var data = JSON.stringify({\n        model: \"gpt-4-0125-preview\",\n        messages: [{\"role\": \"system\", \"content\": conversationSummary}]\n    });\n\n    xhr.send(data);\n}\n\n\/\/ Example usage\nsendSummaryToGPT(function(response) {\n    console.log(\"GPT's response:\", response);\n}, function(error) {\n    console.log(\"Error:\", error);\n});","QuestionText_Unsafe":"<style>\n.spinner {\n  border: 4px solid rgba(0, 0, 0, 0.1);\n  width: 36px;\n  height: 36px;\n  border-radius: 50%;\n  border-left-color: #09f;\n  animation: spin 1s ease infinite;\n\n  \/* Centering styles *\/\n  position: absolute; \/* Use absolute positioning within a relative container *\/\n  top: 50%; \/* Position the top edge of the spinner in the middle of the container *\/\n  left: 50%; \/* Position the left edge of the spinner in the middle of the container *\/\n  transform: translate(-50%, -50%); \/* Offset the spinner by half its width and height to center it *\/\n}\n\n\/* Make sure the parent container has a relative position *\/\n#parentContainer {\n  position: relative;\n}\n\n@keyframes spin {\n  0% {\n    transform: rotate(0deg);\n  }\n  100% {\n    transform: rotate(360deg);\n  }\n}\n<\/style>\n\n<div id=\"loadingMessage\" style=\"display: none;\">\n    <p> The next page may take a moment to load. Please do not refresh your browser or leave the page. <\/p>\n    \n<\/div>\n\n<div id=\"finishedMessage\" style=\"display: none;\">\n    <p>All set! Please proceed by clicking the arrow button.<\/p>\n    \n<\/div>\n\n<div id=\"loadingSpinner\" class=\"spinner\" style=\"display:none;\"><\/div>","DataExportTag":"infoSearchGPT_Contro","QuestionID":"QID109"}},{"SurveyID":"SV_39IRNTCn5hF9YDs","Element":"SQ","PrimaryAttribute":"QID140","SecondaryAttribute":"The next page may take a moment to load. Please do not refresh your browser or